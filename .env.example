ENVIRONMENT=development

# Database: either one URL (Neon/Supabase/Render) or the discrete values below.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gateway

# Redis: set USE_REDIS=false to use in-process rate limiting/caching instead.
USE_REDIS=true
# REDIS_URL=rediss://default:pass@host:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Required in production: 32+ random characters (e.g. `openssl rand -hex 32`).
SECRET_KEY=change-me

# Bootstrap admin created on first start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

CORS_ORIGINS=*

# Upstream provider keys (comma-separate several to round-robin between them).
OPENAI_API_KEYS=
GROQ_API_KEYS=
GEMINI_API_KEYS=
